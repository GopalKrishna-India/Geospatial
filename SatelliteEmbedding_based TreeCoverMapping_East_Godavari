    '2019': ['2018-01-01', '2019-01-01'],
    '2025': ['2024-01-01', '2025-01-01']
};

// === Satellite Embedding Extraction ===
function getSatelliteEmbedding(start, end, roi) {
    return ee.ImageCollection('GOOGLE/SATELLITE_EMBEDDING/V1/ANNUAL')
        .filterDate(start, end)
        .filterBounds(roi)
        .median()
        .clip(roi);
}

// === Image Preparation for Classification ===
function prepareImage(year) {
    var start = years[year][0];
    var end = years[year][1];
    var embedding = getSatelliteEmbedding(start, end, guntur);
    var combined = embedding
        .addBands(dem)
        .addBands(slope)
        .addBands(aspect);
    return combined.clip(guntur);
}

// === Classification & Visualization ===
var classifiedMap = {};

function classifyAndVisualize(year) {
    var image = prepareImage(year);

    var training = image.sampleRegions({
        collection: trainSet,
        properties: ['class'],
        scale: 10,
    });

    var classifier = ee.Classifier.smileRandomForest(100).train({
        features: training,
        classProperty: 'class',
        inputProperties: image.bandNames()
    });

    var classified = (image.classify(classifier)).updateMask(RFAmask.unmask().not());
    classifiedMap[year] = classified;

    // Visualization params for satellite embedding bands (first 3 bands as RGB)
    var embeddingViz = {min: -0.3, max: 0.3, bands: ['A01', 'A16', 'A09']};

    // Add satellite embedding visualization layer below classification layer
    Map.addLayer(image, embeddingViz, year + ' Satellite Embedding', false);
    Map.addLayer(classified.updateMask(classified.eq(1)), {palette: ['006400']}, year + ' Tree Cover');
    Map.addLayer(classified.updateMask(classified.eq(0)), {palette: ['gray']}, year + ' Non-Tree', false);
}


// Run classifier for both years
classifyAndVisualize('2019');
classifyAndVisualize('2025');

// === Validation with 20% Holdout Data ===
function validateClassification(classifiedImage, valSet, classProperty, yearLabel) {
    var validated = classifiedImage.sampleRegions({
        collection: valSet,
        properties: [classProperty],
        scale: 10,
        tileScale: 8,
        geometries: true
    });
    var confusionMatrix = validated.errorMatrix(classProperty, 'classification');
    print('Confusion Matrix for ' + yearLabel, confusionMatrix);
    print('Overall Accuracy for ' + yearLabel, confusionMatrix.accuracy());
    print('Kappa Coefficient for ' + yearLabel, confusionMatrix.kappa());
    print('Producer Accuracy for ' + yearLabel, confusionMatrix.producersAccuracy());
    print('User Accuracy for ' + yearLabel, confusionMatrix.consumersAccuracy());
    return validated;
}

validateClassification(classifiedMap['2019'], valSet, 'class', '2019');
validateClassification(classifiedMap['2025'], valSet, 'class', '2025');

// === Tree Cover Area Calculation ===
function calculateTreeArea(classifiedImage, year) {
    var pixelArea = ee.Image.pixelArea();
    var treeMask = classifiedImage.eq(1);
    var treeAreaImage = pixelArea.updateMask(treeMask);
    var stats = treeAreaImage.reduceRegion({
        reducer: ee.Reducer.sum(),
        geometry: guntur,
        scale: 10,
        maxPixels: 1e13,
        tileScale: 8
    });
    var area_ha = ee.Number(stats.get('area')).divide(10000);
    print('Tree cover area in ' + year + ':', area_ha, 'hectares');
}
calculateTreeArea(classifiedMap['2019'], '2019');
calculateTreeArea(classifiedMap['2025'], '2025');

